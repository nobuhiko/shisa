    rb_cache: '戻す: キャッシュ', rb_maint_off: '戻す: メンテナンスを外す', rb_verify: '戻す: 確かめる', rolled_back: '元に戻した' };
  function renderUpgrade(p, d) {
    var box = el('div', 'sh-fix sh-upgrade'); box.id = 'sh-fix-' + p.proposal_id;
    box.appendChild(el('h4', null, p.title || ('EC-CUBE を ' + p.to_version + ' に上げる')));
    box.appendChild(el('div', 'path', 'EC-CUBE ' + p.from_version + ' → ' + p.to_version + '(公式の修正版)'));
    box.appendChild(el('p', 'owner', p.owner_text));
    box.appendChild(el('div', 'sh-upgrade-sum', p.diff || ''));
    if (p.keep && p.keep.length) {
      box.appendChild(el('div', 'sh-upgrade-sum sh-upgrade-keep', '点検で当てた新しい修正版のまま残す部品: ' + p.keep.map(function (k) { return k.name + ' ' + k.version + '(配布物は ' + k.release_version + ')'; }).join('、')));
    }
    var res = el('div', 'sh-fix-result'); res.id = 'sh-fix-result-' + p.proposal_id;
    var u = p.upgrade || {};
    if (p.status === 'pending') {
      box.appendChild(el('div', 'sh-fix-note', '承認すると、お店を数分メンテナンスにして、公式の手順で上げます。先にファイルとデータベースの控えを取り、途中で失敗したら控えから元に戻します。リスクは店主さんが取ります。'));
      var act = el('div', 'actions');
      var codeIn = el('input', 'form-control sh-confirm-code'); codeIn.type = 'text'; codeIn.inputMode = 'numeric'; codeIn.maxLength = 4; codeIn.placeholder = p.confirm_code || ''; codeIn.id = 'sh-code-' + p.proposal_id;
      var btn = el('button', 'btn btn-ec-conversion sh-approve-btn', '承認して上げる'); btn.type = 'button'; btn.id = 'sh-approve-' + p.proposal_id;
      var stop = p.changed ? '提案のあとに EC-CUBE の版が変わっています。次の点検で提案し直します' : !p.content_ok ? '提案の中身が合わないので、承認できません'
        : !d.can_approve ? '承認できるのは、システム管理者か店舗オーナーの権限の管理者だけです' : !p.confirm_code ? '画面を開き直してください' : '';
      if (stop) { btn.disabled = true; codeIn.disabled = true; res.className = 'sh-fix-result ng'; res.textContent = stop; }
      btn.addEventListener('click', function () { approve(p, btn, res, codeIn.value.trim()); });
      if (!stop) { act.appendChild(el('span', 'sh-code-label', '確認コード ' + p.confirm_code + ' を入力:')); act.appendChild(codeIn); }
      act.appendChild(btn);
      box.appendChild(act);
    } else {
      var ul = el('ul', 'sh-upgrade-log');
      (u.log || []).forEach(function (l) { ul.appendChild(el('li', null, l.text)); });
      box.appendChild(ul);
      if (p.status === 'running') { res.className = 'sh-fix-result'; res.textContent = '上げています: ' + (UP_STEPS[u.step] || u.step || '始めています') + ' …'; }
      else if (p.status === 'applied') { res.className = 'sh-fix-result ok'; res.textContent = p.to_version + ' に上げました。お店を開いて確かめました'; }
      else if (p.status === 'stale') { res.className = 'sh-fix-result ng'; res.textContent = '調べたときから、お店のファイルが変わっています。もう一度調べてから、提案し直します(何も書いていません)'; }
      else if (p.status === 'rolled_back') { res.className = 'sh-fix-result ng'; res.textContent = '途中で失敗したので、控えから ' + p.from_version + ' に戻しました。お店は開いています'; }
      else { res.className = 'sh-fix-result ng'; res.textContent = '上げられませんでした' + (u.error && u.error.detail ? ': ' + u.error.detail : ''); }
      window.__shUpgrade = p.status;
    }
    box.appendChild(res);
    fixList.appendChild(box);
    return p.status === 'running';
  }
  function loadProposals() {
    // 版上げの途中は、管理画面が一時的に答えないことがある。そのときも少し待って見に行き続ける
    // 版上げでファイルを置き換えている間は、答えが返らないままの呼び出しもある。10 秒で切って、見に行き直す
    var ac = window.AbortController ? new AbortController() : null;
    var cut = ac ? setTimeout(function () { ac.abort(); }, 10000) : null;
    return fetch(proposalsUrl, { credentials: 'same-origin', signal: ac ? ac.signal : undefined }).then(function (r) {
      clearTimeout(cut);
      // EC-CUBE の版が変わると、管理画面のログインが切れることがある(ログインの画面へ回される)
      if (r.redirected && /\/login/.test(r.url)) throw { relogin: true };
      return r.json();
    }).then(renderProposals)
      .catch(function (e) {
        if (upRunning && e && e.relogin) {
          upRunning = false; clearTimeout(upTimer);
          var box = document.querySelector('.sh-upgrade .sh-fix-result');
          if (box) { box.className = 'sh-fix-result'; box.textContent = 'EC-CUBE の版が変わったので、管理画面のログインが切れました。もう一度ログインして、この画面を開くと結果が出ます'; }
          window.__shUpgrade = 'relogin';
        } else if (upRunning) { clearTimeout(upTimer); upTimer = setTimeout(loadProposals, 4000); }
        return [];
      });
  }
  function approve(p, btn, res, code) {
    if (!/^[0-9]{4}$/.test(code || '')) { res.className = 'sh-fix-result ng'; res.textContent = '確認コード(4 けたの数字)を入力してください'; return; }
    btn.disabled = true; res.className = 'sh-fix-result'; res.textContent = p.kind === 'upgrade' ? '承認しました。版上げを始めています…' : '控えを取って直し、お店を開いて確かめています…';
    // 画面で見た中身(ハッシュ)と確認コードを一緒に送る。お店の側で、見せたものと同じかを確かめてから印を作る
    var body = new URLSearchParams({ _token: token, sha256_new: p.sha256_new || '', sha256_before: p.sha256_before || '', confirm_code: code });
    fetch(approveBase + encodeURIComponent(p.proposal_id), { method: 'POST', credentials: 'same-origin', headers: { 'ECCUBE-CSRF-TOKEN': token }, body: body })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var v = d.result && d.result.verify ? d.result.verify.map(function (x) { return x.path + ' ' + x.status; }).join('、') : '';
        if (p.kind === 'upgrade') {
          if (d.ok && d.status === 'running') { res.className = 'sh-fix-result'; res.textContent = '版上げを始めました。進み具合はこの下に出ます'; window.__shApproved = 'running'; upRunning = true; loadProposals(); }
          else { res.className = 'sh-fix-result ng'; res.textContent = '始められませんでした: ' + (d.detail || d.error || ''); btn.disabled = false; window.__shApproved = 'failed'; }
          return;
        }
        if (d.ok && d.status === 'applied') { res.className = 'sh-fix-result ok'; res.textContent = '直しました。控えを取ってから書き、お店を開いて確かめました(' + v + ')'; }
        else if (d.ok && d.status === 'rolled_back') { res.className = 'sh-fix-result ng'; res.textContent = 'お店が開けなくなったので、すぐに元に戻しました(' + v + ')'; }
        else { res.className = 'sh-fix-result ng'; res.textContent = '直せませんでした: ' + (d.detail || d.error || ''); btn.disabled = false; }
        window.__shApproved = d.status || 'failed';
      })
      .catch(function () { res.className = 'sh-fix-result ng'; res.textContent = '直せませんでした(つながりませんでした)'; btn.disabled = false; window.__shApproved = 'failed'; });
  }
  window.__shFix = { load: loadProposals };

  function open(runId) {
    clearTimeout(timer); current = runId; shown = 0; stepsEl.textContent = ''; reportEl.hidden = true; card.hidden = false;
    poll(runId);
  }

  // 画面を開いたら最新の点検を出す。API が新しい点検を始めたら、それに切り替えて流す
  function watchNew() {
    fetch(runsUrl, { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var latest = d.ok && d.runs && d.runs[0];
        if (latest && latest.run_id !== current) open(latest.run_id);
        else timer = setTimeout(watchNew, 10000);
      })
      .catch(function () { timer = setTimeout(watchNew, 15000); });
  }

  function begin(btn, advisory) {
    var err = document.getElementById('sh-error'); err.hidden = true;
    if (advisory === '') { err.textContent = '通知の URL を貼ってください'; err.hidden = false; return; }
    btn.disabled = true;
    var body = new URLSearchParams({ advisory_url: advisory || '', _token: token });
    fetch(startUrl, { method: 'POST', credentials: 'same-origin', headers: { 'ECCUBE-CSRF-TOKEN': token }, body: body })
      .then(function (r) { return r.json(); })
      .then(function (d) { btn.disabled = false; if (d.ok) open(d.run_id); else { err.textContent = d.detail || d.error || '始められませんでした'; err.hidden = false; } })
      .catch(function () { btn.disabled = false; err.textContent = '始められませんでした'; err.hidden = false; });
  }
  var start = document.getElementById('sh-start');
  // 撮影用: ?film=<記録> を付けて開くと、「通知を渡す」で本物の点検は始めず、その記録を早送りで流す(画面に「記録を早送りで再生」が出る)
  var filmRun = new URLSearchParams(location.search).get('film');
  // 撮影: hold=<ミリ秒> で止めどころの長さ(ナレーションに合わせる)。film のときは、お知らせの出どころを画面に出さず、経過の欄に寄せる
  var FILM_HOLD = Math.min(15000, Math.max(1000, Number(new URLSearchParams(location.search).get('hold')) || 2500));
  // holds=<ms>,<ms>,... で止めどころごとの長さ(n 番目の止めどころ)。書いていない止めどころは hold
  var FILM_HOLDS = (new URLSearchParams(location.search).get('holds') || '').split(',').map(function (x) { return Math.min(20000, Math.max(0, Number(x) || 0)); });
  var stopNo = 0;
  var FILM_FLOW = !!new URLSearchParams(location.search).get('film');
  var FILM_RS = Math.min(1000, Math.max(80, Number(new URLSearchParams(location.search).get('rs')) || 180));
  if (filmRun) document.body.classList.add('sh-film');
  // 撮影の目印: 止めどころのたびに右上の 24px の四角を白黒に反転する(録画は時計どおりに進まないので、組み立てでは録画の中のこの反転を探して行の音声を置き、四角は見出しの色で塗りつぶす)
  var filmMarkN = 0;
  function filmMark() {
    if (!document.body.classList.contains('sh-film')) return;
    var m = document.getElementById('sh-film-mark');
    if (!m) { m = document.createElement('div'); m.id = 'sh-film-mark'; m.style.cssText = 'position:fixed;right:0;top:0;width:24px;height:24px;z-index:2147483647;background:#000'; document.body.appendChild(m); }
    m.style.background = filmMarkN++ % 2 ? '#000' : '#fff';
  }
  if (filmRun) { var fm0 = document.createElement('div'); fm0.id = 'sh-film-mark'; fm0.style.cssText = 'position:fixed;right:0;top:0;width:24px;height:24px;z-index:2147483647;background:#000'; document.body.appendChild(fm0); }
  if (new URLSearchParams(location.search).get('big') === '1') document.body.classList.add('sh-big');
  if (start) start.addEventListener('click', function () {
    var adv = document.getElementById('sh-advisory').value.trim();
    if (filmRun && /^run_[0-9a-f]{8,32}$/.test(filmRun)) { if (adv) replay(filmRun); return; }
    begin(start, adv);
  });
  var now = document.getElementById('sh-now');
  if (now) now.addEventListener('click', function () { begin(now, null); });
  {% if connected %}if (!new URLSearchParams(location.search).get('replay') && !new URLSearchParams(location.search).get('film')) { watchNew(); loadProposals(); }{% endif %}
  document.querySelectorAll('.sh-open').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); open(a.getAttribute('data-run')); }); });
  document.querySelectorAll('.sh-replay').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); replay(a.getAttribute('data-run')); }); });
  // ?replay=<run_id>&seconds=<全体の秒数> で開くと、すぐに再生する(撮影用)
  var q = new URLSearchParams(location.search);
  if (q.get('replay') && /^run_[0-9a-f]{8,32}$/.test(q.get('replay'))) replay(q.get('replay'));
})();
</script>
{% endblock %}
