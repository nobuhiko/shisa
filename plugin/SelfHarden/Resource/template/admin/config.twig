{% extends '@admin/default_frame.twig' %}

{% set menus = ['store', 'plugin', 'plugin_list'] %}

{% block title %}Shisa{% endblock %}
{% block sub_title %}お店の守り神{% endblock %}

{% block stylesheet %}
<style>
  .sh-steps { list-style: none; padding: 0; margin: 0; max-height: 480px; overflow-y: auto; font-size: 14px; }
  .sh-steps li { padding: 6px 0; border-bottom: 1px solid #eee; display: flex; gap: 10px; }
  .sh-steps time { color: #888; flex: none; font-variant-numeric: tabular-nums; }
  .sh-steps .k-think { color: #333; }
  .sh-steps .k-tool, .sh-steps .k-result { color: #0b5394; }
  .sh-steps .k-error { color: #b00020; }
  .sh-steps .k-report { font-weight: bold; }
  .sh-steps .res { color: #2e7d32; margin-left: 8px; }
  .sh-steps .tool { color: #999; font-size: 12px; margin-left: 8px; }
  .sh-steps li.key { animation: sh-flash 2.4s ease-out; }
  .sh-steps li.key .res { font-weight: bold; }
  @keyframes sh-flash { 0% { background: #fff3c4; } 100% { background: transparent; } }
  .sh-steps .ff { margin-left: 8px; color: #8a6d00; font-variant-numeric: tabular-nums; }
  .sh-replay-badge { display: inline-block; margin-left: 8px; font-size: 12px; padding: 1px 8px; border-radius: 10px; background: #eef2ff; color: #3949ab; }
  .sh-steps .k-error .res { color: #b00020; }
  .sh-steps details { flex: 1; } .sh-steps summary { cursor: pointer; list-style: none; }
  .sh-steps summary::-webkit-details-marker { display: none; }
  .sh-steps pre { white-space: pre-wrap; word-break: break-all; font-size: 12px; background: #f7f7f7; padding: 6px; margin: 4px 0 0; max-height: 240px; overflow: auto; }
  .sh-report h3 { font-size: 16px; margin-top: 18px; }
  .sh-report .sev { display: inline-block; min-width: 3.5em; font-size: 12px; padding: 1px 6px; border-radius: 3px; background: #eee; margin-right: 6px; }
  .sh-report .sev-high { background: #fde0e0; } .sh-report .sev-medium { background: #fff1d6; }
  .sh-report .summary { white-space: pre-wrap; font-size: 15px; }
  .sh-report .sh-draft { white-space: pre-wrap; background: #f7f7f7; border-left: 3px solid #ccc; padding: 8px 10px; font-size: 13px; margin: 6px 0; }
  .sh-band { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2000; background: #1f2933; color: #fff; font-size: 26px; font-weight: 700; padding: 16px 28px; text-align: center; transform: translateY(100%); transition: transform .25s; }
  .sh-band.show { transform: none; } .sh-band.warn { color: #ffcc80; } .sh-band.good { color: #a5d6a7; }
  .sh-steps li.sh-research { color: #8a8a8a; font-size: 13px; }
  .sh-steps li.key { background: #fff3c4; }
  .sh-health td, .sh-health th { padding: 10px 16px; vertical-align: middle; }
  .sh-health th { font-size: 12px; color: #888; font-weight: normal; }
  .sh-health .item { font-weight: bold; white-space: nowrap; }
  .sh-health .j { font-weight: bold; white-space: nowrap; }
  .sh-health .j-ok { color: #2e7d32; } .sh-health .j-fixed { color: #2e7d32; } .sh-health .j-mit { color: #1565c0; } .sh-health .j-human { color: #b26a00; } .sh-health .j-next { color: #3949ab; } .sh-health .j-approve { color: #7b1fa2; }
  .sh-health tr { transition: background .4s; } .sh-health tr.in { background: #f1f8e9; }
  body.sh-big .sh-health td { font-size: 17px; }
  body.sh-film #sh-runs-card, body.sh-film #sh-connect-card { display: none; }
  body.sh-film #sh-advisory { filter: blur(6px); }
  body.sh-health-focus #sh-check-card, body.sh-health-focus #sh-progress-card { display: none; }
  body.sh-health-focus #sh-health-card .card-header { font-size: 26px; font-weight: 700; }
  body.sh-health-focus .sh-health td, body.sh-health-focus.sh-big .sh-health td { font-size: 24px; padding: 18px 20px; }
  body.sh-health-focus .sh-health th { font-size: 16px; }
  body.sh-film .sh-steps, body.sh-film.sh-big .sh-steps { font-size: 21px; max-height: calc(100vh - 560px); } body.sh-film { padding-bottom: 90px; } body.sh-film .sh-steps time { font-size: 15px; } body.sh-film .sh-steps .tool { font-size: 14px; }
  .sh-steps li.k-decision { font-weight: bold; color: #1b5e20; }
  body.sh-big .sh-steps { font-size: 18px; max-height: 60vh; } body.sh-big .sh-steps time { font-size: 15px; }
  body.sh-big .sh-steps .tool { font-size: 13px; } body.sh-big .sh-report { font-size: 17px; }
  .sh-fix { border: 1px solid #e1d5ee; border-radius: 6px; padding: 14px 16px; margin-bottom: 14px; }
  .sh-fix h4 { font-size: 16px; font-weight: bold; margin: 0 0 6px; }
  .sh-fix .path { font-family: monospace; font-size: 12px; color: #666; }
  .sh-fix .owner { white-space: pre-wrap; margin: 8px 0; }
  .sh-fix-diff { font-family: monospace; font-size: 12px; background: #fafafa; border: 1px solid #eee; padding: 6px 0; max-height: 320px; overflow: auto; margin: 8px 0; }
  .sh-fix-diff div { white-space: pre-wrap; word-break: break-all; padding: 0 10px; }
  .sh-fix-diff .del { background: #fde0e0; } .sh-fix-diff .add { background: #e3f6e3; } .sh-fix-diff .gap { color: #999; }
  .sh-fix-diff .add.risky { background: #ffe9a8; outline: 2px solid #e0a000; } .sh-fix-warn { color: #9a5b00; background: #fff6dc; padding: 6px 10px; margin: 6px 0; border-radius: 4px; font-size: 13px; }
  .sh-fix-note { font-size: 13px; color: #555; margin: 6px 0; }
  .sh-upgrade-sum { font-size: 13px; color: #555; margin: 6px 0; } .sh-upgrade-log { font-size: 13px; margin: 8px 0; padding-left: 20px; } .sh-upgrade-log li { margin: 2px 0; } .sh-confirm-code { display: inline-block; width: 90px; margin: 0 8px; } .sh-code-label { font-size: 13px; }
  .sh-fix .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .sh-fix-result { margin-top: 8px; font-weight: bold; } .sh-fix-result.ok { color: #2e7d32; } .sh-fix-result.ng { color: #b00020; }
  .sh-fix details { margin-top: 8px; } .sh-fix details pre { white-space: pre-wrap; background: #f7f7f7; padding: 8px; font-size: 13px; }
  body.sh-big .sh-fix { font-size: 17px; } body.sh-big .sh-fix-diff { font-size: 15px; }
</style>
{% endblock %}

{% block main %}
<div class="sh-band" id="sh-band"></div>
<div class="c-contentsArea__cols">
  <div class="c-contentsArea__primaryCol">
    <div class="c-primaryCol">

      <div class="card rounded border-0 mb-4" id="sh-health-card" hidden>
        <div class="card-header"><span>お店の健康診断</span> <span id="sh-health-meta" class="ml-2 text-muted small"></span></div>
        <div class="card-body p-0">
          <table class="table mb-0 sh-health"><thead><tr><th>項目</th><th>判定</th><th>中身</th></tr></thead><tbody id="sh-health"></tbody></table>
        </div>
      </div>

      <div class="card rounded border-0 mb-4" id="sh-check-card">
        <div class="card-header"><span>点検</span></div>
        <div class="card-body">
          {% if connected %}
            <p>Agent は決まった間隔で、自分でこのサーバーを調べ、弱いところを見つけて守りを固めます。この画面を開いておくと、その経過と結果がここに流れます。何もしなくて大丈夫です。</p>
            <p class="mb-1">気になるセキュリティの通知があれば、URL を貼ってください。その通知がこの店に当てはまるかを調べて対応します。</p>
            <div class="form-row align-items-center">
              <div class="col-8"><input type="url" id="sh-advisory" class="form-control" placeholder="通知の URL https://..."></div>
              <div class="col-auto"><button type="button" id="sh-start" class="btn btn-ec-conversion">通知を渡す</button></div>
              <div class="col-auto"><button type="button" id="sh-now" class="btn btn-ec-regular">今すぐ点検する</button></div>
            </div>
            <p id="sh-error" class="text-danger mt-2" hidden></p>
          {% else %}
            <p>まだ API とつながっていません。下の「API とつなぐ」から始めてください。</p>
          {% endif %}
        </div>
      </div>

      <div class="card rounded border-0 mb-4" id="sh-progress-card" hidden>
        <div class="card-header"><span>経過</span> <span id="sh-status" class="ml-2 text-muted"></span></div>
        <div class="card-body">
          <ul class="sh-steps" id="sh-steps"></ul>
          <div class="sh-report" id="sh-report" hidden></div>
        </div>
      </div>

      <div class="card rounded border-0 mb-4" id="sh-fix-card" hidden>
        <div class="card-header"><span>店主の承認でできること</span> <span class="ml-2 text-muted small">中身を見て承認すると、Shisa が控えを取ってから行い、すぐにお店を開いて確かめます。うまくいかなければ、その場で元に戻します</span></div>
        <div class="card-body" id="sh-fix-list"></div>
      </div>

      {% if runs|length > 0 %}
      <div class="card rounded border-0 mb-4" id="sh-runs-card">
        <div class="card-header"><span>これまでの点検</span></div>
        <div class="card-body">
          <ul class="list-unstyled mb-0">
          {% for r in runs %}
            <li><a href="#" class="sh-open" data-run="{{ r.run_id }}">{{ (r.created_at // 1000)|date("Y-m-d H:i") }}</a>
              {% if r.status != 'running' %}<a href="#" class="sh-replay small ml-1" data-run="{{ r.run_id }}">▶ 再生</a>{% endif %}
              {{ r.status == 'done' ? '完了' : (r.status == 'running' ? '実行中' : '失敗') }}
              {% if r.advisory_url %}<span class="text-muted">({{ r.advisory_url }})</span>{% endif %}</li>
          {% endfor %}
          </ul>
        </div>
      </div>
      {% endif %}

      <div class="card rounded border-0 mb-4" id="sh-connect-card">
        <div class="card-header"><span>API とつなぐ</span></div>
        <div class="card-body">
          {% if connected %}<p>つながっています。店の ID: <code>{{ shop_id }}</code>。つなぎ直すと鍵を新しくします。</p>{% endif %}
          <form method="post" action="{{ url('self_harden_admin_connect') }}">
            <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
            <div class="form-group row"><label class="col-3 col-form-label">API の URL</label>
              <div class="col"><input name="api_base" class="form-control" value="{{ api_base }}"></div></div>
            <details class="mb-3"><summary class="text-muted small">詳しい設定(ふつうは変えなくて大丈夫です)</summary>
            <div class="form-group row mt-2"><label class="col-3 col-form-label">API から見た店の URL</label>
              <div class="col"><input name="self_base" class="form-control" value="{{ self_base }}"></div></div>
            <div class="form-group row"><label class="col-3 col-form-label">外から見た店の URL</label>
              <div class="col"><input name="public_base" class="form-control" value="{{ public_base }}"></div></div>
            </details>
            <button type="submit" class="btn btn-ec-regular">{{ connected ? 'つなぎ直す' : 'API とつなぐ' }}</button>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block javascript %}
<script>
(function () {
  var token = document.querySelector('meta[name="eccube-csrf-token"]').getAttribute('content');
  var startUrl = '{{ url('self_harden_admin_run') }}';
  var runsUrl = '{{ url('self_harden_admin_runs') }}';
  var current = null;
  var statusBase = '{{ url('self_harden_admin_config') }}'.replace(/config$/, 'run/');
  var stepsEl = document.getElementById('sh-steps');
  var reportEl = document.getElementById('sh-report');
  var statusEl = document.getElementById('sh-status');
  var card = document.getElementById('sh-progress-card');
  var timer = null, shown = 0;
  var labels = { running: '実行中…', done: '完了', failed: '止まりました' };
  var sevLabels = { high: '高', medium: '中', low: '低', info: '情報' };
  var stLabels = { fixed: '直した', mitigated: '守りを入れた', scheduled: '次の点検で Shisa が対応', needs_approval: '店主の判断を待つ(メンテナンスが要る作業)', needs_human: 'サーバー会社の作業が必要', not_affected: '当てはまらない' };

  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }

  // ---- お店の健康診断(報告の「見つけたこと」の項目から作る) ----
  var HEALTH_ITEMS = [['php', 'PHP(お店を動かす土台)'], ['eccube', 'EC-CUBE(お店のソフト)'], ['packages', '中の部品(ほかの開発元のプログラム)'],
    ['tamper', '書き換えられた跡'], ['exposure', '外から見えていた情報'], ['config', '設定の甘さ']];
  var JUDGE = { needs_human: [6, 'サーバー会社の作業', 'j-human'], needs_approval: [5, '店主の判断を待つ', 'j-approve'], scheduled: [4, '次の点検で Shisa が対応', 'j-next'], mitigated: [3, '守りを入れた(応急処置)', 'j-mit'], fixed: [2, '処置済み ✓', 'j-fixed'], not_affected: [1, '問題なし', 'j-ok'] };
  // 人に渡す作業のうち、カスタマイズしたコードの直しは制作会社の作業として出す(報告の項目の to: developer)
  var JUDGE_DEV = [6, '制作会社の作業', 'j-human'];
  var JUDGE_FIX = [5, '承認すれば直せる', 'j-approve'];
  function judgeOf(x) { return x.status === 'needs_approval' && x.proposal_id ? JUDGE_FIX : x.status === 'needs_human' && x.to === 'developer' ? JUDGE_DEV : (JUDGE[x.status] || JUDGE.not_affected); }
  function stLabelOf(x) { return x.status === 'needs_approval' && x.proposal_id ? '承認すれば Shisa が直す' : x.status === 'needs_human' && x.to === 'developer' ? '制作会社の作業が必要' : (stLabels[x.status] || x.status); }
  function renderHealth(r, meta, animate) {
    var f = (r && r.findings) || [];
    if (!f.some(function (x) { return x.category; })) return; // 項目の付いていない古い報告では出さない
    var card = document.getElementById('sh-health-card'), body = document.getElementById('sh-health');
    body.textContent = ''; card.hidden = false;
    var items = HEALTH_ITEMS.slice();
    // カスタマイズしたコードの行は、カスタマイズの点検をした報告にだけ出す
    if (f.some(function (x) { return x.category === 'custom'; })) items.splice(4, 0, ['custom', 'カスタマイズしたコード(お店独自のプログラム)']);
    if (f.some(function (x) { return x.category === 'other'; })) items.push(['other', 'その他']);
    var trs = items.map(function (it) {
      var xs = f.filter(function (x) { return x.category === it[0]; });
      var worst = xs.reduce(function (a, x) { var j = judgeOf(x); return !a || j[0] > a[0] ? j : a; }, null) || JUDGE.not_affected;
      // 中身には、判定に使った一番重い発見を出す
      var main = xs.filter(function (x) { return judgeOf(x) === worst; })[0] || xs.filter(function (x) { return x.status !== 'not_affected'; })[0] || xs[0];
      var tr = el('tr');
      tr.appendChild(el('td', 'item', it[1]));
      tr.appendChild(el('td', 'j ' + worst[2], animate ? '要確認' : worst[1]));
      var td = el('td', null, main ? maskOf(main.title) : '見つかったものはありません');
      if (main && worst === JUDGE.not_affected && main.status === 'not_affected' && main.severity && main.severity !== 'info') td.appendChild(el('span', 'text-muted small ml-2', '(このお店には当てはまらない)'));
      if (xs.length > 1) td.appendChild(el('span', 'text-muted small ml-2', '(ほか ' + (xs.length - 1) + ' 件)'));
      if (animate) td.style.visibility = 'hidden';
      tr.appendChild(td); body.appendChild(tr);
      return { tr: tr, judge: worst, td: td };
    });
    var when = meta && meta.at ? new Date(meta.at).toLocaleString('ja-JP') : '';
    document.getElementById('sh-health-meta').textContent = (when ? '最後の点検: ' + when : '') + (meta && meta.interval_hours ? ' / 次の点検: ' + meta.interval_hours + ' 時間ごとに自分で' : '');
    if (animate) {
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      trs.forEach(function (t, i) { setTimeout(function () { t.tr.classList.add('in'); t.tr.children[1].textContent = t.judge[1]; t.td.style.visibility = ''; }, 600 + i * 700); });
    }
  }

  function renderReport(r) {
    reportEl.textContent = '';
    if (!r) return;
    reportEl.hidden = false;
    reportEl.appendChild(el('h3', null, 'まとめ'));
    reportEl.appendChild(el('p', 'summary', r.summary));
    if (r.status) { reportEl.appendChild(el('h3', null, 'いまの守り')); reportEl.appendChild(el('p', 'summary', r.status)); }
    var sections = [
      ['したこと', r.actions, function (a) { var li = el('li', null, a.title + ' — ' + a.target); li.appendChild(el('div', 'text-muted small', '確かめ方: ' + a.verified + (a.backup_id ? '(退避: ' + a.backup_id + ')' : ''))); return li; }],
      ['見つけたこと', r.findings, function (f) { var li = el('li'); li.appendChild(el('span', 'sev sev-' + f.severity, sevLabels[f.severity] || f.severity)); li.appendChild(document.createTextNode(f.title + '(' + stLabelOf(f) + ')')); li.appendChild(el('div', 'text-muted small', f.evidence)); if (f.proposal_id) li.appendChild(el('div', 'small text-primary', '→ 直し方を「店主の承認で直せること」に用意しました')); return li; }],
      ['これから Shisa がやること', r.next_by_self_harden, function (x) { return el('li', null, x.title + (x.when ? '(' + x.when + ')' : '')); }],
      ['お願い(依頼文つき)', r.requests, function (x) {
        var li = el('li', null, x.title + '(宛先: ' + x.to + ')');
        li.appendChild(el('div', 'text-muted small', x.why));
        var pre = el('pre', 'sh-draft', x.message); li.appendChild(pre);
        var btn = el('button', 'btn btn-sm btn-ec-regular', '依頼文をコピー'); btn.type = 'button';
        btn.addEventListener('click', function () { try { navigator.clipboard.writeText(x.message); btn.textContent = 'コピーしました'; } catch (e) {} });
        li.appendChild(btn); return li;
      }],
      ['まだ残っていること', r.remaining, function (x) { var li = el('li', null, x.title + '(' + x.who + ')'); li.appendChild(el('div', 'text-muted small', x.why)); return li; }],
      ['長い目で見て', r.long_term, function (x) { var li = el('li', null, x.title); li.appendChild(el('div', 'text-muted small', x.why)); return li; }],
      ['参考にした情報', r.sources, function (s) { var li = el('li'); var a = el('a', null, s.title); if (/^https?:\/\//.test(s.url)) { a.href = s.url; a.target = '_blank'; a.rel = 'noopener noreferrer'; } li.appendChild(a); return li; }]
    ];
    sections.forEach(function (s) {
      if (!s[1] || !s[1].length) return;
      reportEl.appendChild(el('h3', null, s[0]));
      var ul = el('ul');
      s[1].forEach(function (x) { ul.appendChild(s[2](x)); });
      reportEl.appendChild(ul);
    });
  }

  // 撮影のときは、貼ったお知らせの出どころ(URL とサーバー会社の名前)を出さない
  var maskHosts = [];
  function maskOf(t) {
    if (!t || !document.body.classList.contains('sh-film')) return t;
    t = String(t).replace(/https?:\/\/[^\s)」]+/g, function (u) { try { return maskHosts.indexOf(new URL(u).host) >= 0 ? '(お知らせの URL)' : u; } catch (e) { return u; } });
    maskHosts.forEach(function (h) { var b = h.replace(/^www\./, '').split('.')[0]; if (b) t = t.replace(new RegExp(b, 'ig'), '(サーバー会社)'); });
    return t;
  }
  // 撮影のとき、描いた欄の中の文字をまとめて隠す(報告の欄など)
  function maskTree(root) {
    if (!root || !document.body.classList.contains('sh-film')) return;
    var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), n;
    while ((n = w.nextNode())) n.nodeValue = maskOf(n.nodeValue);
    root.querySelectorAll('a[href]').forEach(function (a) { if (maskOf(a.href) !== a.href) a.removeAttribute('href'); });
  }
  function stepEl(s) {
    var li = el('li', 'k-' + s.kind);
    li.appendChild(el('time', null, new Date(s.at).toLocaleTimeString('ja-JP')));
    // 道具の生の返事(JSON)は店主に見せない(記録には残る)。言葉の詳しい説明だけ開けるようにする
    var detail = s.detail && !/^\s*[\{\[]/.test(s.detail) ? s.detail : '';
    var body = detail ? el('details') : el('span');
    var head = detail ? el('summary') : body;
    head.appendChild(el('span', null, maskOf(s.title)));
    if (s.tool) head.appendChild(el('span', 'tool', maskOf(s.tool)));
    if (s.result) head.appendChild(el('span', 'res', '→ ' + maskOf(s.result)));
    if (detail) { body.appendChild(head); body.appendChild(el('pre', null, detail)); }
    li.appendChild(body);
    return li;
  }

  // ---- 記録の再生(動画用)。記録した経過を同じ順番で流し、大事な行で止める。Claude は呼ばない ----
  // 字幕は、その行(または報告)に書かれていることだけから作る
  var RESEARCH = /公開の情報|ファイルを読む|ファイルの一覧|サーバーを調べる|調べた結果|前回の点検|外から開く|退避の一覧|隔離の一覧|公式との違い|部品の弱点|照らし合わせる/;
  function waitSec(s) { var m = /^(\d+) 秒待つ/.exec(s.tool || ''); return m ? Number(m[1]) : 0; }
